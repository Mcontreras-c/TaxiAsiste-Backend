SECRET_KEY=un_texto_largo_y_seguro_cualquiera_123456
DEBUG=True
ORACLE_HOST=localhost
ORACLE_PORT=1523
# Usar service name para Oracle XE en Docker (prioridad sobre ORACLE_SID)
ORACLE_SERVICE_NAME=XEPDB1
# Solo si no usas ORACLE_SERVICE_NAME (instalacion con SID clasico)
ORACLE_SID=TAXIDB
ORACLE_USER=taxiasiste_app
ORACLE_PASSWORD=TaxiAsiste_App_2026

# Esquema separado para tests automaticos (pytest) -- ver scripts/setup_test_schema.sql
ORACLE_TEST_USER=taxiasiste_test
ORACLE_TEST_PASSWORD=TaxiAsiste_Test_2026

# Clave "TaxiAsiste - Backend" de Google Cloud (Geocoding API + Directions API),
# restringida por API -- ver console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=tu_clave_de_google_maps_para_el_backend

# Cuenta Gmail usada como remitente de correos (bienvenida + recuperacion de
# clave). EMAIL_HOST_PASSWORD es una "clave de app" de 16 caracteres generada
# en myaccount.google.com/apppasswords -- NO la clave normal de la cuenta.
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=clave_de_app_de_16_caracteres
DEFAULT_FROM_EMAIL=TaxiAsiste <tu_correo@gmail.com>

# Link de descarga directa del APK (distribucion temporal antes de Play Store)
APK_DOWNLOAD_URL=https://ejemplo.com/taxiasiste.apk

# Direccion del panel web (va en el correo de bienvenida del personal administrativo)
PANEL_WEB_URL=http://45.236.130.233
